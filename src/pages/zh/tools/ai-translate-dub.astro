---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';

const dmgUrl = "https://github.com/Badakonpro/ai-translate-dub/releases/download/v1.3.1/VoxOver-1.3.1-arm64.dmg";

const features = [
  {
    icon: "🎙",
    title: "Whisper 语音转录",
    desc: "从任意视频中提取语音并转录字幕，支持 tiny/base/small/medium/large 模型。模型本地缓存，无需重复下载。",
  },
  {
    icon: "🌐",
    title: "四种翻译后端",
    desc: "使用本地 Ollama 模型（完全私有，无需 API Key）、DeepSeek 云端翻译、OpenAI（支持自定义 Base URL）或 Anthropic Claude，在设置中随时切换。",
  },
  {
    icon: "📝",
    title: "全局翻译上下文",
    desc: "可选：翻译前先基于视频标题和字幕抽样生成主题、术语和风格提示，再传给每条字幕翻译，提升专业内容的一致性。",
  },
  {
    icon: "⚡️",
    title: "并行翻译",
    desc: "同时翻译多个字幕片段，可调整并发数以平衡速度和 API 限速。",
  },
  {
    icon: "📦",
    title: "三种输出格式",
    desc: "导出独立的 .srt 文件、带软字幕轨的 .mkv（VLC/IINA 中可切换），或硬烧录字幕的 .mp4。",
  },
  {
    icon: "🖥",
    title: "本机运行",
    desc: "Electron 外壳 + 本地 Gradio UI。除非使用 DeepSeek，否则无任何云端上传，视频默认不离开本机。",
  },
];

const steps = [
  { n: "01", title: "安装应用", desc: "下载 DMG，将 VoxOver 拖到 Applications，然后启动。应用会自动启动本地 Gradio 服务器，浏览器将自动打开 http://127.0.0.1:7860。" },
  { n: "02", title: "上传视频", desc: "将任意 MP4 或 MOV 文件拖入 Gradio 界面，音频会自动提取为 16kHz 单声道。" },
  { n: "03", title: "选择 Whisper 模型", desc: "根据精度和速度需求选择 tiny 至 large 模型，首次下载后本地缓存，不重复下载。" },
  { n: "04", title: "选择翻译后端", desc: "连接本地运行的 Ollama 实例，或在设置中填入 DeepSeek / OpenAI / Anthropic API Key。" },
  { n: "05", title: "运行并导出", desc: "转录、翻译、合并全程一键完成，选择 SRT、MKV 或 MP4 导出格式。" },
];
---

<Layout title="VoxOver" description="VoxOver — Mac 端 AI 视频转录与字幕翻译工具。Whisper + Ollama/DeepSeek/OpenAI/Anthropic。导出 SRT、MKV 或 MP4。">
  <Nav slot="nav" />

  <!-- HERO -->
  <section class="tool-hero">
    <div class="container tool-hero-inner">
      <div>
        <div class="tool-hero-badges">
          <span class="badge badge-beta">测试版</span>
          <span class="tool-hero-version">v1.3.1</span>
          <span class="tool-hero-platform">macOS arm64</span>
        </div>
        <h1 class="tool-hero-title">VoxOver</h1>
        <p class="tool-hero-desc">
          使用 Whisper 转录视频字幕，通过 Ollama、DeepSeek、OpenAI 或 Anthropic 翻译，
          导出 SRT、MKV 软字幕或硬烧录 MP4 —— 全部在本地 Mac 应用内完成。
          无需账号，无需订阅。
        </p>
        <div class="tool-hero-actions">
          <a href={dmgUrl} class="btn btn-primary btn-lg">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 1v9M4.5 7l3.5 3.5L11.5 7M2 13h12" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
            免费下载 DMG
          </a>
          <a href="/zh/download" class="btn btn-outline btn-lg">全部下载</a>
        </div>
        <p class="tool-hero-req">macOS · Apple Silicon (arm64) · 需要 Python 3 + ffmpeg</p>
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>功能介绍</h2>
      </div>
      <div class="features-grid">
        {features.map(f => (
          <div class="feature-card">
            <div class="feature-icon">{f.icon}</div>
            <h3>{f.title}</h3>
            <p>{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section section-bg">
    <div class="container">
      <div class="section-header">
        <h2>使用流程</h2>
      </div>
      <ol class="steps">
        {steps.map(s => (
          <li class="step">
            <div class="step-number">{s.n}</div>
            <div>
              <h3 class="step-title">{s.title}</h3>
              <p class="step-desc">{s.desc}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- OUTPUT FORMATS -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>输出格式</h2>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>格式</th><th>说明</th><th>适用场景</th></tr>
          </thead>
          <tbody>
            <tr>
              <td><code>.srt</code></td>
              <td>带时间轴的纯字幕文件</td>
              <td>在任意编辑器或播放器中复用</td>
            </tr>
            <tr>
              <td><code>.mkv</code></td>
              <td>原视频 + 软字幕轨道</td>
              <td>本地播放，在 VLC/IINA 中可切换字幕</td>
            </tr>
            <tr>
              <td><code>.mp4</code></td>
              <td>字幕硬烧录到视频</td>
              <td>上传就绪，适合 YouTube、社交媒体</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- REQUIREMENTS -->
  <section class="section section-bg">
    <div class="container">
      <div class="section-header">
        <h2>运行环境</h2>
      </div>
      <div class="req-grid">
        <div class="req-card">
          <h3>系统 / 环境</h3>
          <ul>
            <li>macOS（推荐 Apple Silicon arm64）</li>
            <li>本机安装 Python 3</li>
            <li>ffmpeg（<code>brew install ffmpeg</code>）</li>
          </ul>
        </div>
        <div class="req-card">
          <h3>本地翻译（Ollama）</h3>
          <ul>
            <li>本机已运行 Ollama</li>
            <li>已拉取兼容模型，如 <code>qwen3:latest</code></li>
            <li>配置完成后无需联网</li>
          </ul>
        </div>
        <div class="req-card">
          <h3>云端翻译</h3>
          <ul>
            <li>DeepSeek / OpenAI / Anthropic API Key</li>
            <li>OpenAI 支持自定义 Base URL，兼容所有 OpenAI 格式 API</li>
            <li>需要网络连接</li>
            <li>按量计费（无订阅）</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>常见问题</h2>
      </div>
      <dl class="faq">
        <div class="faq-item">
          <dt>视频会上传到云端吗？</dt>
          <dd>不会。视频处理（音频提取、Whisper 转录）全部在本机进行。仅在选择 DeepSeek 后端时，字幕文本会发送至 DeepSeek。Ollama 完全本地运行。</dd>
        </div>
        <div class="faq-item">
          <dt>用哪个 Whisper 模型合适？</dt>
          <dd><code>base</code> 速度快，对大多数内容精度够用。技术内容或口音较重的语音建议使用 <code>medium</code> 或 <code>large</code>。模型首次下载后缓存在本机，不重复下载。</dd>
        </div>
        <div class="faq-item">
          <dt>可以翻译成任何语言吗？</dt>
          <dd>翻译质量取决于所选后端模型。Ollama 的 <code>qwen3</code> 等模型支持中文、日文、韩文及主要欧洲语言。DeepSeek 支持 50+ 种语言。</dd>
        </div>
        <div class="faq-item">
          <dt>Whisper 模型缓存在哪里？</dt>
          <dd>模型缓存至 <code>~/Library/Application Support/VoxOver/whisper-models</code>。如果 <code>~/.cache/whisper</code> 中已有有效模型，首次启动时会自动复制。</dd>
        </div>
        <div class="faq-item">
          <dt>是否支持 Intel Mac？</dt>
          <dd>当前 DMG 仅支持 arm64。Intel 支持可能在后续版本加入，目前可从源码在 Intel 机器上运行。</dd>
        </div>
        <div class="faq-item">
          <dt>是免费的吗？</dt>
          <dd>是的，应用免费且开源（MIT）。DeepSeek API 费用按 DeepSeek 官方标准按量计费。</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-strip">
    <div class="container cta-strip-inner">
      <div>
        <h2>下载 VoxOver</h2>
        <p>v1.3.1 · macOS arm64 · 免费开源 (MIT)</p>
      </div>
      <div class="cta-strip-actions">
        <a href={dmgUrl} class="btn btn-primary btn-lg">下载 DMG</a>
        <a href="https://github.com/Badakonpro/ai-translate-dub" target="_blank" rel="noopener" class="btn btn-outline btn-lg" style="color:#fff;border-color:rgba(255,255,255,0.35);">在 GitHub 上查看</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
.tool-hero { padding: 5rem 0 4rem; border-bottom: 1px solid var(--color-border); }
.tool-hero-badges { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem; flex-wrap: wrap; }
.tool-hero-version, .tool-hero-platform {
  font-size: 0.75rem; font-weight: 600; padding: 0.2rem 0.55rem;
  border-radius: 4px; background: var(--color-bg-muted);
  color: var(--color-text-muted); border: 1px solid var(--color-border);
}
.tool-hero-title { margin-bottom: 1rem; }
.tool-hero-desc { max-width: 55ch; font-size: 1.0625rem; color: var(--color-text-secondary); margin-bottom: 1.75rem; }
.tool-hero-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
.tool-hero-req { margin-top: 1rem; font-size: 0.8125rem; color: var(--color-text-muted); }

.section-header { margin-bottom: 2.5rem; }
.section-header h2 { margin-bottom: 0; }
.section-bg { background: var(--color-bg-subtle); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }

.features-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem; }
.feature-card { background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 1.5rem; }
.feature-icon { font-size: 1.75rem; margin-bottom: 0.9rem; }
.feature-card h3 { margin-bottom: 0.4rem; font-size: 1rem; }
.feature-card p { font-size: 0.875rem; color: var(--color-text-secondary); }

.steps { list-style: none; display: flex; flex-direction: column; gap: 1.25rem; max-width: 680px; }
.step { display: flex; gap: 1.25rem; align-items: flex-start; }
.step-number { font-size: 0.8125rem; font-weight: 800; color: var(--color-accent); background: #EEF2FF; border-radius: 6px; padding: 0.25rem 0.6rem; flex-shrink: 0; letter-spacing: 0.04em; margin-top: 0.1rem; }
.step-title { font-size: 1rem; margin-bottom: 0.3rem; }
.step-desc { font-size: 0.9rem; color: var(--color-text-secondary); line-height: 1.65; }

.table-wrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; font-size: 0.9375rem; }
th, td { text-align: left; padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-border); }
th { font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-text-muted); background: var(--color-bg-subtle); }
td code { font-size: 0.875rem; background: var(--color-bg-muted); padding: 0.15rem 0.4rem; border-radius: 4px; border: 1px solid var(--color-border); }

.req-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem; }
.req-card { background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 1.5rem; }
.req-card h3 { font-size: 0.9375rem; margin-bottom: 0.75rem; }
.req-card ul { margin: 0; padding-left: 1.1rem; display: flex; flex-direction: column; gap: 0.4rem; }
.req-card li { font-size: 0.875rem; color: var(--color-text-secondary); line-height: 1.5; }
.req-card code { font-size: 0.8125rem; background: var(--color-bg-muted); padding: 0.1rem 0.35rem; border-radius: 3px; border: 1px solid var(--color-border); }

.faq { display: flex; flex-direction: column; gap: 0; max-width: 720px; }
.faq-item { padding: 1.25rem 0; border-bottom: 1px solid var(--color-border); }
.faq-item:first-child { border-top: 1px solid var(--color-border); }
.faq-item dt { font-size: 0.9375rem; font-weight: 700; margin-bottom: 0.5rem; }
.faq-item dd { margin: 0; font-size: 0.9rem; color: var(--color-text-secondary); line-height: 1.7; }
.faq-item dd code { font-size: 0.8125rem; background: var(--color-bg-muted); padding: 0.1rem 0.35rem; border-radius: 3px; border: 1px solid var(--color-border); }

.cta-strip { background: var(--color-accent); padding: 3.5rem 0; }
.cta-strip-inner { display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
.cta-strip h2 { color: #fff; margin-bottom: 0.25rem; }
.cta-strip p { color: rgba(255,255,255,0.75); font-size: 0.9375rem; }
.cta-strip-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
</style>
