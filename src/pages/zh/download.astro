---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getLatestRelease } from '../../lib/release';

const rel = await getLatestRelease();

const releases = [
  {
    tool: "VoxOver",
    version: rel.tag,
    date: rel.date,
    assets: [
      {
        label: "macOS（Apple Silicon）",
        filename: rel.dmgFilename,
        url: rel.dmgUrl,
        size: rel.dmgSizeMB,
        icon: "💻",
      },
    ],
    notes: [
      "打开 DMG，将 VoxOver 拖到 Applications 文件夹，然后启动",
      "原生 macOS 应用，无需安装 Python、pip 或 Gradio",
      "首次启动如遇安全提示，前往 系统设置 → 隐私与安全性 → 仍要打开",
      "Ollama 后端：启动 Ollama，在应用内拉取模型（如 qwen3:latest）",
      "DeepSeek / OpenAI / Anthropic：在设置中填入 API Key — OpenAI 支持自定义 Base URL",
    ],
    releaseUrl: rel.releaseUrl,
  },
];
---

<Layout title="下载" description="下载 LingYue Tools 原生 macOS 应用，针对 Apple Silicon 硬件加速优化。">
  <Nav slot="nav" />

  <section class="section">
    <div class="container">
      <div class="page-header">
        <h1>下载</h1>
        <p>本站仅提供原生 macOS 软件，支持 Apple Silicon 硬件加速。所有工具均免费，无需账号。</p>
      </div>

      {releases.map(r => (
        <div class="release-card">
          <div class="release-header">
            <div>
              <h2 class="release-tool">{r.tool}</h2>
              <div class="release-meta">
                <span class="release-version">{r.version}</span>
                <span class="release-date">发布于 {r.date}</span>
              </div>
            </div>
            <a href={r.releaseUrl} target="_blank" rel="noopener" class="btn btn-outline">查看发布说明</a>
          </div>

          <div class="assets-list">
            {r.assets.map(a => (
              <a href={a.url} class="asset-row" data-asset="voxover-dmg" data-url={a.url} onclick="trackDownload(event, this)">
                <span class="asset-icon">{a.icon}</span>
                <div class="asset-info">
                  <span class="asset-label">{a.label}</span>
                  <span class="asset-filename">{a.filename}</span>
                </div>
                <span class="asset-size">{a.size}</span>
                <span class="asset-download-btn">
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 1v9M4.5 7l3.5 3.5L11.5 7M2 13h12" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  下载
                </span>
              </a>
            ))}
          </div>
          <div class="download-stats">
            <span class="stats-icon">↓</span>
            <span id="download-count-voxover">—</span> 次下载
          </div>

          <div class="release-notes">
            <h3>安装说明</h3>
            <ul>
              {r.notes.map(n => <li>{n}</li>)}
            </ul>
          </div>
        </div>
      ))}

      <div class="source-note">
        <p>
          所有工具均开源。
          <a href="https://github.com/Badakonpro/ai-translate-dub" target="_blank" rel="noopener">在 GitHub 上查看源码</a>，
          如不使用预构建 DMG，也可从源码运行。
        </p>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
.page-header { margin-bottom: 2.5rem; }
.page-header p { color: var(--color-text-secondary); }

.release-card {
  background: var(--color-bg); border: 1px solid var(--color-border);
  border-radius: var(--radius-lg); padding: 2rem; margin-bottom: 2rem;
}
.release-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
.release-tool { font-size: 1.2rem; margin-bottom: 0.5rem; }
.release-meta { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
.release-version { font-size: 0.8125rem; font-weight: 700; color: var(--color-text); }
.release-date { font-size: 0.8125rem; color: var(--color-text-muted); }

.assets-list { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1.5rem; }
.asset-row {
  display: flex; align-items: center; gap: 1rem;
  padding: 0.9rem 1.1rem; border: 1px solid var(--color-border);
  border-radius: var(--radius-md); text-decoration: none; color: inherit;
  transition: border-color 0.15s, background 0.15s;
}
.asset-row:hover { border-color: var(--color-accent); background: #fafafa; }
.asset-icon { font-size: 1.25rem; flex-shrink: 0; }
.asset-info { flex: 1; min-width: 0; }
.asset-label { display: block; font-size: 0.9375rem; font-weight: 600; }
.asset-filename { display: block; font-size: 0.8125rem; color: var(--color-text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.asset-size { font-size: 0.8125rem; color: var(--color-text-muted); flex-shrink: 0; }
.asset-download-btn {
  display: flex; align-items: center; gap: 0.4rem;
  font-size: 0.8125rem; font-weight: 700; color: var(--color-accent);
  flex-shrink: 0;
}

.release-notes h3 { font-size: 0.875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-muted); margin-bottom: 0.75rem; }
.release-notes ul { margin: 0; padding-left: 1.2rem; display: flex; flex-direction: column; gap: 0.35rem; }
.release-notes li { font-size: 0.9rem; color: var(--color-text-secondary); line-height: 1.5; }

.source-note {
  background: var(--color-bg-subtle); border: 1px solid var(--color-border);
  border-radius: var(--radius-md); padding: 1.25rem 1.5rem;
}
.source-note p { font-size: 0.9rem; color: var(--color-text-secondary); }

.download-stats {
  display: flex; align-items: center; gap: 0.4rem;
  font-size: 0.8125rem; color: var(--color-text-muted);
  margin-top: 0.5rem;
}
.stats-icon { font-style: normal; }
</style>

<script>
// @ts-nocheck
const WORKER = "";

async function trackDownload(e, el) {
  e.preventDefault();
  const asset = el.dataset.asset;
  const url = el.dataset.url;
  if (!asset || !url) {
    return;
  }
  try {
    const res = await fetch(`${WORKER}/api/download?asset=${asset}`, { method: "POST" });
    if (res.ok) {
      const { count } = await res.json();
      const el2 = document.getElementById(`download-count-${asset.replace("-dmg", "")}`);
      if (el2) el2.textContent = count.toLocaleString();
    }
  } catch (_) {}
  window.location.href = url;
}

(async () => {
  try {
    const res = await fetch(`${WORKER}/api/count?asset=voxover-dmg`);
    if (res.ok) {
      const { count } = await res.json();
      const el = document.getElementById("download-count-voxover");
      if (el) el.textContent = count.toLocaleString();
    }
  } catch (_) {}
})();
</script>
