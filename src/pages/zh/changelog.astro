---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getLatestReleaseSummary } from '../../lib/release';

const latest = await getLatestReleaseSummary();

const historicalEntries = [
  {
    version: "v1.0.0",
    date: "2026-05-28",
    tool: "VoxOver",
    highlights: [
      "首个公开发布版本",
      "Whisper 转录，支持 tiny/base/small/medium/large 模型",
      "Whisper 模型持久缓存 — 下载一次，跨会话复用",
      "详细转录进度：音频时长、等待时间、当前模型",
      "Ollama 本地翻译后端（无需联网）",
      "DeepSeek API 翻译后端",
      "可选全局翻译上下文：翻译前生成主题/术语/风格提示，再传给每条字幕",
      "并行翻译，并发数可配置",
      "输出格式：SRT、MKV 软字幕、MP4 硬烧录字幕",
      "Electron macOS 外壳，内置本地 Gradio UI",
    ],
    releaseUrl: "https://github.com/Badakonpro/ai-translate-dub/releases/tag/v1.0.0",
  },
];

const entries = [
  {
    version: latest.tag,
    date: latest.date,
    tool: "VoxOver",
    highlights: latest.highlights.length > 0 ? latest.highlights : ["请在 GitHub Release 查看完整更新说明。"],
    releaseUrl: latest.releaseUrl,
  },
  ...historicalEntries.filter((entry) => entry.version !== latest.tag),
];
---

<Layout title="更新日志" description="LingYue Tools 更新日志 — VoxOver 及所有工具的版本历史。">
  <Nav slot="nav" />

  <section class="section">
    <div class="container">
      <div class="page-header">
        <h1>更新日志</h1>
        <p>各版本新增内容。</p>
      </div>

      <div class="changelog">
        {entries.map(e => (
          <div class="entry">
            <div class="entry-sidebar">
              <span class="entry-version">{e.version}</span>
              <span class="entry-date">{e.date}</span>
            </div>
            <div class="entry-body">
              <div class="entry-header">
                <h2 class="entry-title">{e.tool} — {e.version}</h2>
                <a href={e.releaseUrl} target="_blank" rel="noopener" class="btn btn-outline" style="font-size:0.8125rem;padding:0.3rem 0.8rem;">GitHub Release ↗</a>
              </div>
              <ul class="entry-list">
                {e.highlights.map(h => <li>{h}</li>)}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
.page-header { margin-bottom: 3rem; }
.page-header p { color: var(--color-text-secondary); }

.changelog { display: flex; flex-direction: column; gap: 0; }
.entry {
  display: grid; grid-template-columns: 140px 1fr; gap: 2rem;
  padding: 2rem 0; border-bottom: 1px solid var(--color-border);
}
.entry:first-child { border-top: 1px solid var(--color-border); }

.entry-sidebar { display: flex; flex-direction: column; gap: 0.35rem; align-items: flex-start; padding-top: 0.2rem; }
.entry-version { font-size: 0.9375rem; font-weight: 700; }
.entry-date { font-size: 0.8125rem; color: var(--color-text-muted); }

.entry-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.25rem; flex-wrap: wrap; }
.entry-title { font-size: 1.125rem; margin: 0; }

.entry-list { margin: 0; padding-left: 1.2rem; display: flex; flex-direction: column; gap: 0.4rem; }
.entry-list li { font-size: 0.9375rem; color: var(--color-text-secondary); line-height: 1.6; }

@media (max-width: 600px) {
  .entry { grid-template-columns: 1fr; gap: 0.75rem; }
  .entry-sidebar { flex-direction: row; align-items: center; gap: 0.5rem; }
}
</style>
