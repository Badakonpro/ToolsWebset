---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="关于" description="关于 LingYue Tools — 由独立开发者构建的个人工具站。">
  <Nav slot="nav" />

  <section class="page-hero">
    <div class="container">
      <h1>关于</h1>
    </div>
  </section>

  <section class="section-sm">
    <div class="container about-layout">
      <div class="about-main prose">

        <h2>这是什么？</h2>
        <p>
          LingYue Tools 是我个人的工具站，我在这里发布自己构建并日常使用的小工具 ——
          主要围绕视频、字幕、AI 和 Mac 工作流。
        </p>
        <p>
          这里所有的东西都由一个人完成。没有团队、没有投资方、没有公司背书，
          只是一些我觉得有用、并想分享出来的工具。
        </p>

        <h2>当前工具</h2>
        <p>
          第一款工具是 <strong>VoxOver</strong> —— 放入视频，选择 Whisper 模型，
          选择翻译后端（本地 Ollama 或 DeepSeek），导出翻译后的 SRT、MKV 软字幕或硬烧录 MP4。
          构建这款工具是因为我经常需要为不同受众添加字幕，又想要一个本地运行、
          无需账号和订阅的方案。
        </p>

        <h2>接下来</h2>
        <p>
          我计划持续添加小而专注的工具 —— 字幕硬烧录、音频转录、视频压缩、SRT 翻译等等。
          每款工具只解决一个具体问题，尽量保持轻量。
        </p>

        <h2>联系方式</h2>
        <p>
          如有 Bug 反馈、功能建议，或只是想打个招呼：
        </p>
        <p>
          📧 <a href="mailto:hello@lingyuetools.org">hello@lingyuetools.org</a>
        </p>
        <p>
          我会读每一封邮件，通常在一两天内回复。
        </p>

      </div>

      <aside class="about-sidebar">
        <div class="sidebar-card">
          <div class="dev-avatar">👨‍💻</div>
          <p class="dev-label">独立开发者</p>
          <p class="dev-note">小步构建，专注每一个问题。</p>
          <hr style="border-top:1px solid var(--color-border);margin:1rem 0;" />
          <div class="dev-links">
            <a href="mailto:hello@lingyuetools.org">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><rect x="1" y="3" width="12" height="8" rx="1.5" stroke="currentColor" stroke-width="1.25"/><path d="M1 4l6 4 6-4" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"/></svg>
              邮件联系
            </a>
            <a href="https://github.com/Badakonpro" target="_blank" rel="noopener noreferrer">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.09.682-.217.682-.482 0-.237-.009-.868-.013-1.703-2.782.604-3.369-1.342-3.369-1.342-.454-1.154-1.11-1.462-1.11-1.462-.908-.62.069-.607.069-.607 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.564 9.564 0 0112 6.844a9.59 9.59 0 012.504.337c1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.741 0 .267.18.577.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/></svg>
              GitHub
            </a>
          </div>
        </div>

        <div class="sidebar-card">
          <p class="sidebar-card-title">隐私</p>
          <p>工具本地运行，无追踪，无需账号。</p>
          <a href="/zh/privacy" class="sidebar-link">隐私政策 →</a>
        </div>
      </aside>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
  .page-hero { padding: 4rem 0 2.5rem; border-bottom: 1px solid var(--color-border); }

  .about-layout {
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: 3rem;
    align-items: start;
  }

  .about-sidebar { display: flex; flex-direction: column; gap: 1rem; position: sticky; top: 80px; }

  .sidebar-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }
  .sidebar-card-title { font-weight: 700; font-size: 0.9rem; color: var(--color-text); margin-bottom: 0.35rem; }
  .sidebar-link { display: inline-block; margin-top: 0.6rem; font-size: 0.875rem; color: var(--color-accent); }

  .dev-avatar { font-size: 2.5rem; text-align: center; margin-bottom: 0.75rem; }
  .dev-label { font-weight: 700; font-size: 0.875rem; color: var(--color-text); text-align: center; }
  .dev-note { font-size: 0.8125rem; color: var(--color-text-muted); text-align: center; margin-top: 0.25rem; }
  .dev-links { display: flex; flex-direction: column; gap: 0.5rem; }
  .dev-links a {
    display: flex; align-items: center; gap: 0.5rem;
    font-size: 0.875rem; color: var(--color-text-secondary);
    text-decoration: none !important;
    padding: 0.35rem 0.5rem;
    border-radius: var(--radius-sm);
    transition: background 0.15s, color 0.15s;
  }
  .dev-links a:hover { background: var(--color-bg-muted); color: var(--color-text); }

  @media (max-width: 720px) {
    .about-layout { grid-template-columns: 1fr; }
    .about-sidebar { order: -1; position: static; }
  }
</style>
