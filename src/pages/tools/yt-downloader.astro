---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getLatestYTDRelease } from '../../lib/release-ytdownloader';

const { tag, version, dmgUrl, releaseUrl } = await getLatestYTDRelease();

const features = [
  {
    icon: "📋",
    title: "Clipboard Auto-Detection — No Manual Paste",
    desc: "Copy a YouTube URL and YTDownloader detects it instantly. No need to open the app first — just copy, then click Download.",
  },
  {
    icon: "🎬",
    title: "Quality Selection — Best, 1080p, 720p, 480p, 360p, MP3",
    desc: "Pick your preferred quality before downloading. Audio-only MP3 export is available for podcasts, music, and lectures.",
  },
  {
    icon: "📊",
    title: "Live Progress — Speed, ETA, and File Size",
    desc: "Real-time download feedback: speed, estimated time remaining, and file size. No spinner-only UI.",
  },
  {
    icon: "⏸",
    title: "Pause, Resume, and Cancel",
    desc: "Full job control — pause mid-way, resume later, or cancel. Clear finished jobs to keep the window tidy.",
  },
  {
    icon: "📦",
    title: "Batteries Included — yt-dlp, ffmpeg, ffprobe Bundled",
    desc: "No Homebrew or PATH setup needed. yt-dlp, ffmpeg, and ffprobe ship inside the app package.",
  },
  {
    icon: "🗂",
    title: "Saves to ~/Downloads/YouTube",
    desc: "All downloads land in a dedicated ~/Downloads/YouTube folder, named and organized automatically.",
  },
];

const steps = [
  { n: "01", title: "Install the app", desc: "Download the DMG, drag YTDownloader.app to /Applications, and launch. If macOS blocks it, use Control-click > Open." },
  { n: "02", title: "Copy a YouTube URL", desc: "Copy any YouTube video link. YTDownloader detects it from the clipboard and pre-fills the input automatically." },
  { n: "03", title: "Choose quality", desc: "Pick best, 1080p, 720p, 480p, 360p, or audio-only MP3." },
  { n: "04", title: "Download", desc: "Click Go. Live progress updates in real time. The file lands in ~/Downloads/YouTube when done." },
];

const softwareSchemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "YTDownloader",
  "operatingSystem": "macOS 13+",
  "applicationCategory": "MultimediaApplication",
  "applicationSubCategory": "Video Downloader",
  "softwareVersion": version,
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "url": "https://lingyuetools.org/tools/yt-downloader",
  "downloadUrl": dmgUrl,
  "description": "Free native macOS YouTube downloader. Clipboard auto-detection, quality selection (best/1080p/720p/480p/360p/MP3), live progress. Bundles yt-dlp, ffmpeg, ffprobe.",
  "author": { "@type": "Organization", "name": "LingYue Tools", "url": "https://lingyuetools.org" },
  "featureList": [
    "Clipboard auto-detection of YouTube URLs",
    "Quality selection: best, 1080p, 720p, 480p, 360p, audio-only MP3",
    "Live download progress with speed, ETA, and file size",
    "Pause, resume, and cancel downloads",
    "Bundled yt-dlp, ffmpeg, ffprobe",
    "Auto-saves to ~/Downloads/YouTube",
    "SwiftUI native macOS app"
  ],
  "requirements": "macOS 13 or later, Apple Silicon (arm64)",
  "isAccessibleForFree": true,
  "inLanguage": "en"
});

const faqSchemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Is YTDownloader free?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. YTDownloader is free to download and use." }},
    { "@type": "Question", "name": "Does YTDownloader need Homebrew or ffmpeg installed?",
      "acceptedAnswer": { "@type": "Answer", "text": "No. yt-dlp, ffmpeg, and ffprobe are all bundled inside the app package. You don't need Homebrew or any command-line setup." }},
    { "@type": "Question", "name": "Where are downloads saved?",
      "acceptedAnswer": { "@type": "Answer", "text": "All downloads go to ~/Downloads/YouTube automatically." }},
    { "@type": "Question", "name": "macOS says the app is from an unidentified developer. How do I open it?",
      "acceptedAnswer": { "@type": "Answer", "text": "Right-click the app in Finder and choose Open, then confirm. Or run: xattr -dr com.apple.quarantine /Applications/YTDownloader.app" }},
    { "@type": "Question", "name": "Is Intel Mac supported?",
      "acceptedAnswer": { "@type": "Answer", "text": "The published DMG is Apple Silicon (arm64) only. Intel Mac users can build from source using Xcode command line tools and make dmg." }},
    { "@type": "Question", "name": "Can YTDownloader download from sites other than YouTube?",
      "acceptedAnswer": { "@type": "Answer", "text": "YTDownloader is designed for YouTube. It uses yt-dlp internally, which supports many sites, but the UI and clipboard detection are optimized for YouTube URLs." }}
  ]
});

const breadcrumbSchemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://lingyuetools.org" },
    { "@type": "ListItem", "position": 2, "name": "Tools", "item": "https://lingyuetools.org/tools" },
    { "@type": "ListItem", "position": 3, "name": "YTDownloader" }
  ]
});
---

<Layout title="YTDownloader — Free Native macOS YouTube Downloader" description="YTDownloader — free native macOS app to download YouTube videos. Clipboard auto-detection, quality selection (best/1080p/720p/480p/360p/MP3), live progress. Bundles yt-dlp and ffmpeg. No Homebrew needed." ogImage="/og-image-ytdownloader.png">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={softwareSchemaJson} />
    <script type="application/ld+json" set:html={faqSchemaJson} />
    <script type="application/ld+json" set:html={breadcrumbSchemaJson} />
    <link rel="alternate" hreflang="zh" href="https://lingyuetools.org/zh/tools/yt-downloader" />
    <link rel="alternate" hreflang="en" href="https://lingyuetools.org/tools/yt-downloader" />
  </Fragment>
  <Nav slot="nav" />

  <!-- HERO -->
  <section class="tool-hero">
    <div class="container tool-hero-inner">
      <div>
        <div class="tool-hero-badges">
          <span class="tool-hero-version">v{version}</span>
          <span class="tool-hero-platform">macOS arm64</span>
          <span class="tool-hero-badge-free">Free Download</span>
        </div>
        <h1 class="tool-hero-title">YTDownloader</h1>
        <p class="tool-hero-desc">
          A native macOS app for downloading YouTube videos from a copied or pasted link.
          Clipboard auto-detection, quality selection, live progress — and yt-dlp, ffmpeg, ffprobe are all bundled.
          No terminal, no Homebrew, no setup.
        </p>
        <div class="tool-hero-actions">
          <a href={dmgUrl} class="btn btn-primary btn-lg">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 1v9M4.5 7l3.5 3.5L11.5 7M2 13h12" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Download DMG — Free
          </a>
          <a href="https://github.com/Badakonpro/YTDownloader" target="_blank" rel="noopener" class="btn btn-outline btn-lg">View on GitHub</a>
        </div>
        <p class="tool-hero-req">macOS 13+ · Apple Silicon (arm64) · No dependencies required</p>
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Core Features</h2>
      </div>
      <div class="features-grid">
        {features.map(f => (
          <div class="feature-card">
            <div class="feature-icon">{f.icon}</div>
            <h3>{f.title}</h3>
            <p>{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section section-bg">
    <div class="container">
      <div class="section-header">
        <h2>How it works</h2>
      </div>
      <ol class="steps">
        {steps.map(s => (
          <li class="step">
            <div class="step-number">{s.n}</div>
            <div>
              <h3 class="step-title">{s.title}</h3>
              <p class="step-desc">{s.desc}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- QUALITY OPTIONS -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Quality options</h2>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Option</th><th>Description</th><th>Best for</th></tr>
          </thead>
          <tbody>
            <tr>
              <td><code>Best</code></td>
              <td>Highest available resolution and bitrate</td>
              <td>Archiving, editing source material</td>
            </tr>
            <tr>
              <td><code>1080p</code></td>
              <td>Full HD video</td>
              <td>Local playback on large displays</td>
            </tr>
            <tr>
              <td><code>720p</code></td>
              <td>HD video, smaller file size</td>
              <td>Balance of quality and storage</td>
            </tr>
            <tr>
              <td><code>480p / 360p</code></td>
              <td>Standard definition</td>
              <td>Low storage, mobile devices</td>
            </tr>
            <tr>
              <td><code>Audio-only MP3</code></td>
              <td>Audio extracted and converted to MP3</td>
              <td>Podcasts, music, lectures</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- REQUIREMENTS -->
  <section class="section section-bg">
    <div class="container">
      <div class="section-header">
        <h2>Requirements</h2>
      </div>
      <div class="req-grid">
        <div class="req-card">
          <h3>System</h3>
          <ul>
            <li>macOS 13 or later</li>
            <li>Apple Silicon (arm64)</li>
            <li>Internet connection for downloading</li>
          </ul>
        </div>
        <div class="req-card">
          <h3>Bundled — nothing to install</h3>
          <ul>
            <li>yt-dlp (bundled)</li>
            <li>ffmpeg (bundled)</li>
            <li>ffprobe (bundled)</li>
          </ul>
        </div>
        <div class="req-card">
          <h3>First launch</h3>
          <ul>
            <li>App is ad-hoc signed, not notarized</li>
            <li>Use Control-click &gt; Open in Finder</li>
            <li>Or: <code>xattr -dr com.apple.quarantine /Applications/YTDownloader.app</code></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>FAQ</h2>
      </div>
      <dl class="faq">
        <div class="faq-item">
          <dt>Is it free?</dt>
          <dd>Yes. YTDownloader is free to download and use.</dd>
        </div>
        <div class="faq-item">
          <dt>Do I need Homebrew or ffmpeg installed?</dt>
          <dd>No. yt-dlp, ffmpeg, and ffprobe are all bundled inside the app. Just download and run.</dd>
        </div>
        <div class="faq-item">
          <dt>Where are downloads saved?</dt>
          <dd>All files go to <code>~/Downloads/YouTube</code> automatically.</dd>
        </div>
        <div class="faq-item">
          <dt>macOS blocks the app on first launch — what do I do?</dt>
          <dd>Right-click the app in Finder and choose Open, then confirm. Alternatively, run <code>xattr -dr com.apple.quarantine /Applications/YTDownloader.app</code> in Terminal.</dd>
        </div>
        <div class="faq-item">
          <dt>Is Intel Mac supported?</dt>
          <dd>The published DMG targets Apple Silicon (arm64). Intel users can build from source: <code>cd YTDownloader && make dmg</code>. You need Xcode CLI tools and <code>curl</code>.</dd>
        </div>
        <div class="faq-item">
          <dt>What if a video fails to download?</dt>
          <dd>yt-dlp may need updating when YouTube changes its format. Rebuild the app or manually replace the bundled <code>yt-dlp</code> binary inside the app package.</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-strip">
    <div class="container cta-strip-inner">
      <div>
        <h2>Download YTDownloader</h2>
        <p>v{version} · macOS arm64 · Free</p>
      </div>
      <div class="cta-strip-actions">
        <a href={dmgUrl} class="btn btn-primary btn-lg">Download DMG</a>
        <a href={releaseUrl} target="_blank" rel="noopener" class="btn btn-outline btn-lg" style="color:#fff;border-color:rgba(255,255,255,0.35);">View on GitHub</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
.tool-hero { padding: 5rem 0 4rem; border-bottom: 1px solid var(--color-border); }
.tool-hero-badges { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem; flex-wrap: wrap; }
.tool-hero-version, .tool-hero-platform {
  font-size: 0.75rem; font-weight: 600; padding: 0.2rem 0.55rem;
  border-radius: 4px; background: var(--color-bg-muted);
  color: var(--color-text-muted); border: 1px solid var(--color-border);
}
.tool-hero-badge-free {
  font-size: 0.75rem; font-weight: 700; padding: 0.2rem 0.55rem;
  border-radius: 4px; background: #dcfce7; color: #15803d;
  border: 1px solid #bbf7d0;
}
.tool-hero-title { margin-bottom: 1rem; }
.tool-hero-desc { max-width: 55ch; font-size: 1.0625rem; color: var(--color-text-secondary); margin-bottom: 1.75rem; }
.tool-hero-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
.tool-hero-req { margin-top: 1rem; font-size: 0.8125rem; color: var(--color-text-muted); }

.section-header { margin-bottom: 2.5rem; }
.section-header h2 { margin-bottom: 0; }
.section-bg { background: var(--color-bg-subtle); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }

.features-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem; }
.feature-card { background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 1.5rem; }
.feature-icon { font-size: 1.75rem; margin-bottom: 0.9rem; }
.feature-card h3 { margin-bottom: 0.4rem; font-size: 1rem; }
.feature-card p { font-size: 0.875rem; color: var(--color-text-secondary); }

.steps { list-style: none; display: flex; flex-direction: column; gap: 1.25rem; max-width: 680px; }
.step { display: flex; gap: 1.25rem; align-items: flex-start; }
.step-number { font-size: 0.8125rem; font-weight: 800; color: var(--color-accent); background: #EEF2FF; border-radius: 6px; padding: 0.25rem 0.6rem; flex-shrink: 0; letter-spacing: 0.04em; margin-top: 0.1rem; }
.step-title { font-size: 1rem; margin-bottom: 0.3rem; }
.step-desc { font-size: 0.875rem; color: var(--color-text-secondary); }

.table-wrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
th { text-align: left; font-size: 0.8125rem; font-weight: 700; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.05em; padding: 0.6rem 1rem; border-bottom: 2px solid var(--color-border); }
td { padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-border); color: var(--color-text-secondary); }
tr:last-child td { border-bottom: none; }
td:first-child { color: var(--color-text); font-weight: 600; }

.req-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; }
.req-card { background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 1.5rem; }
.req-card h3 { font-size: 0.9375rem; margin-bottom: 0.75rem; }
.req-card ul { list-style: none; display: flex; flex-direction: column; gap: 0.4rem; }
.req-card li { font-size: 0.875rem; color: var(--color-text-secondary); padding-left: 1rem; position: relative; }
.req-card li::before { content: "·"; position: absolute; left: 0; color: var(--color-accent); font-weight: 700; }

.faq { max-width: 680px; display: flex; flex-direction: column; gap: 1.5rem; }
.faq-item dt { font-weight: 600; margin-bottom: 0.4rem; }
.faq-item dd { font-size: 0.9375rem; color: var(--color-text-secondary); margin: 0; }

.cta-strip { background: var(--color-accent); padding: 4rem 0; }
.cta-strip-inner { display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
.cta-strip h2 { color: #fff; }
.cta-strip p { color: rgba(255,255,255,0.75); margin-top: 0.35rem; font-size: 0.9375rem; }
.cta-strip-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
.cta-strip .btn-primary { background: #fff; color: var(--color-accent); border-color: #fff; }
.cta-strip .btn-primary:hover { background: #F0F0FF; }

@media (max-width: 600px) {
  .tool-hero { padding: 3.5rem 0 3rem; }
  .cta-strip-inner { flex-direction: column; align-items: flex-start; }
}
</style>
