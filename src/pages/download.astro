---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const installSteps = [
  { step: "Download", desc: 'Click the button below to download <code>VideoTranslator-0.1.0.dmg</code>.' },
  { step: "Open DMG", desc: "Double-click the downloaded DMG file." },
  { step: "Drag to Applications", desc: "Drag the Video Translator icon into your Applications folder." },
  { step: "First Launch", desc: 'Right-click the app icon in Applications and choose <strong>Open</strong>. Confirm when macOS asks.' },
  { step: "Start translating", desc: "Drop in a video, pick a language, and export." },
];
---

<Layout title="Download" description="Download Video Translator for Mac — free Beta. macOS 13+, Apple Silicon and Intel supported.">
  <Nav slot="nav" />

  <section class="page-hero">
    <div class="container">
      <h1>Download</h1>
      <p class="page-subtitle">Free Beta · macOS 13 or later</p>
    </div>
  </section>

  <section class="section-sm">
    <div class="container download-layout">

      <!-- MAIN DOWNLOAD CARD -->
      <div class="download-card">
        <div class="download-card-header">
          <div class="download-icon">
            <svg width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true">
              <rect width="40" height="40" rx="11" fill="#EEF2FF"/>
              <path d="M20 12v12M14 20l6 6 6-6" stroke="#4F46E5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M12 30h16" stroke="#4F46E5" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </div>
          <div>
            <h2 class="download-app-name">Video Translator for Mac</h2>
            <div class="download-meta">
              <span class="badge badge-beta">v0.1.0 Beta</span>
              <span class="meta-item">~80 MB</span>
              <span class="meta-item">macOS 13+</span>
            </div>
          </div>
        </div>

        <div class="download-buttons">
          <!-- Replace href with your actual GitHub Release URL -->
          <a
            href="https://github.com/YOUR_USERNAME/video-translator/releases/download/v0.1.0/VideoTranslator-0.1.0.dmg"
            class="btn btn-primary btn-lg download-main-btn"
          >
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M9 2v10M5 9l4 4 4-4M2 15h14" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Download for macOS (Apple Silicon)
          </a>
          <a
            href="https://github.com/YOUR_USERNAME/video-translator/releases/download/v0.1.0/VideoTranslator-0.1.0-Intel.dmg"
            class="btn btn-outline"
          >
            Intel Mac version
          </a>
        </div>

        <div class="download-requirements">
          <p><strong>System requirements:</strong> macOS 13 Ventura or later · Apple Silicon recommended · Intel (Rosetta) supported</p>
        </div>

        <!-- GitHub Release link -->
        <div class="github-link">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.09.682-.217.682-.482 0-.237-.009-.868-.013-1.703-2.782.604-3.369-1.342-3.369-1.342-.454-1.154-1.11-1.462-1.11-1.462-.908-.62.069-.607.069-.607 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.564 9.564 0 0112 6.844a9.59 9.59 0 012.504.337c1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.741 0 .267.18.577.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/></svg>
          <a href="https://github.com/YOUR_USERNAME/video-translator/releases" target="_blank" rel="noopener noreferrer">
            View all releases on GitHub
          </a>
        </div>
      </div>

      <!-- SIDE PANEL -->
      <div class="download-sidebar">

        <!-- Beta notice -->
        <div class="notice notice-beta">
          <div class="notice-icon">⚠️</div>
          <div>
            <p class="notice-title">Early Beta</p>
            <p>This is an early release. You may encounter bugs. Please <a href="mailto:hello@tinyvideotools.com">send feedback</a> if something doesn't work.</p>
          </div>
        </div>

        <!-- macOS security notice -->
        <div class="notice notice-macos">
          <div class="notice-icon">🔒</div>
          <div>
            <p class="notice-title">macOS Security Notice</p>
            <p>
              Because this app is not yet notarized with Apple, macOS may show a warning on first launch.
            </p>
            <p style="margin-top:0.5rem;">
              To open it: <strong>right-click the app icon → Open → Open</strong>.
            </p>
          </div>
        </div>

        <!-- SHA256 -->
        <div class="notice">
          <p class="notice-title">File verification (SHA-256)</p>
          <code class="sha-value">Coming with final release</code>
        </div>

      </div>
    </div>
  </section>

  <!-- INSTALL STEPS -->
  <section class="section" style="background:var(--color-bg-subtle);border-top:1px solid var(--color-border);">
    <div class="container">
      <h2 style="margin-bottom:2rem;">Installation steps</h2>
      <ol class="install-steps">
        {installSteps.map((s, i) => (
          <li class="install-step">
            <div class="install-step-num">{i + 1}</div>
            <div>
              <p class="install-step-label">{s.step}</p>
              <p class="install-step-desc" set:html={s.desc} />
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- FEEDBACK -->
  <section class="section">
    <div class="container feedback-cta">
      <div class="feedback-body">
        <h2>Found a bug or have a suggestion?</h2>
        <p>
          Send me an email or open an issue on GitHub. I respond to every message.
        </p>
        <div style="display:flex;gap:0.75rem;flex-wrap:wrap;margin-top:1.25rem;">
          <a href="mailto:hello@tinyvideotools.com" class="btn btn-primary">Send Feedback by Email</a>
          <a href="https://github.com/YOUR_USERNAME/video-translator/issues" class="btn btn-outline" target="_blank" rel="noopener noreferrer">Open GitHub Issue</a>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
  .page-hero { padding: 4rem 0 2.5rem; border-bottom: 1px solid var(--color-border); }
  .page-hero h1 { margin-bottom: 0.4rem; }
  .page-subtitle { font-size: 1rem; color: var(--color-text-secondary); }

  .download-layout {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 2rem;
    align-items: start;
  }

  .download-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2rem;
    box-shadow: var(--shadow-sm);
  }

  .download-card-header { display: flex; gap: 1.25rem; align-items: center; margin-bottom: 1.75rem; }
  .download-icon { flex-shrink: 0; }
  .download-app-name { font-size: 1.25rem; margin-bottom: 0.5rem; }
  .download-meta { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
  .meta-item { font-size: 0.8rem; color: var(--color-text-muted); font-weight: 500; }

  .download-buttons { display: flex; flex-direction: column; gap: 0.6rem; margin-bottom: 1.25rem; }
  .download-main-btn { justify-content: center; }

  .download-requirements {
    padding: 0.9rem 1rem;
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-size: 0.8375rem;
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
  }

  .github-link {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8375rem;
    color: var(--color-text-muted);
  }
  .github-link a { color: var(--color-text-secondary); }

  /* Sidebar notices */
  .download-sidebar { display: flex; flex-direction: column; gap: 1rem; }
  .notice {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1rem 1.1rem;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
  }
  .notice-beta { border-left: 3px solid var(--color-warning); }
  .notice-macos { border-left: 3px solid var(--color-accent); }
  .notice-title { font-weight: 700; font-size: 0.875rem; color: var(--color-text); margin-bottom: 0.35rem; }
  .notice-icon { font-size: 1.1rem; margin-bottom: 0.35rem; }
  .notice-body { display: flex; flex-direction: column; }

  .sha-value {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.775rem;
    color: var(--color-text-muted);
    word-break: break-all;
    background: var(--color-bg-muted);
    padding: 0.35rem 0.5rem;
    border-radius: 4px;
    border: 1px solid var(--color-border);
  }

  /* Install steps */
  .install-steps { list-style: none; display: flex; flex-direction: column; gap: 1rem; max-width: 540px; }
  .install-step { display: flex; gap: 1.1rem; align-items: flex-start; }
  .install-step-num {
    flex-shrink: 0; width: 30px; height: 30px; border-radius: 50%;
    background: var(--color-accent-subtle); color: var(--color-accent);
    display: flex; align-items: center; justify-content: center;
    font-size: 0.875rem; font-weight: 700; border: 1.5px solid var(--color-accent);
  }
  .install-step-label { font-weight: 700; font-size: 0.9375rem; margin-bottom: 0.15rem; }
  .install-step-desc { font-size: 0.875rem; color: var(--color-text-secondary); line-height: 1.6; }

  /* Feedback */
  .feedback-cta {
    max-width: 580px;
  }
  .feedback-body h2 { margin-bottom: 0.5rem; }
  .feedback-body p { color: var(--color-text-secondary); font-size: 0.9375rem; }

  @media (max-width: 860px) {
    .download-layout { grid-template-columns: 1fr; }
    .download-sidebar { order: -1; }
  }
</style>
