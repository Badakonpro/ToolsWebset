---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getLatestRelease } from '../lib/release';

const rel = await getLatestRelease();

const releases = [
  {
    tool: "VoxOver",
    version: rel.tag,
    date: rel.date,
    assets: [
      {
        label: "macOS (Apple Silicon)",
        filename: rel.dmgFilename,
        url: rel.dmgUrl,
        size: rel.dmgSizeMB,
        icon: "💻",
      },
    ],
    notes: [
      "Open the DMG and drag VoxOver to your Applications folder, then launch it",
      "The app starts a local Gradio server automatically — open http://127.0.0.1:7860 in your browser if it doesn't open automatically",
      "Install Python dependencies: pip install -r requirements.txt  (requires Python 3)",
      "Install ffmpeg: brew install ffmpeg",
      "Ollama backend: start Ollama, then pull a model from inside the app (e.g. qwen3:latest)",
      "DeepSeek / OpenAI / Anthropic: enter your API key in Settings — OpenAI supports custom Base URL",
    ],
    releaseUrl: rel.releaseUrl,
  },
];
---

<Layout title="Download" description="Download native macOS apps from LingYue Tools, optimized for Apple Silicon hardware acceleration.">
  <Nav slot="nav" />

  <section class="section">
    <div class="container">
      <div class="page-header">
        <h1>Downloads</h1>
        <p>Mac-only native apps with Apple Silicon hardware acceleration. All tools are free. No account required.</p>
      </div>

      {releases.map(r => (
        <div class="release-card">
          <div class="release-header">
            <div>
              <h2 class="release-tool">{r.tool}</h2>
              <div class="release-meta">
                <span class="release-version">{r.version}</span>
                <span class="release-date">Released {r.date}</span>
              </div>
            </div>
            <a href={r.releaseUrl} target="_blank" rel="noopener" class="btn btn-outline">View Release Notes</a>
          </div>

          <div class="assets-list">
            {r.assets.map(a => (
              <a href={a.url} class="asset-row" data-asset="voxover-dmg" data-url={a.url} onclick="trackDownload(event, this)">
                <span class="asset-icon">{a.icon}</span>
                <div class="asset-info">
                  <span class="asset-label">{a.label}</span>
                  <span class="asset-filename">{a.filename}</span>
                </div>
                <span class="asset-size">{a.size}</span>
                <span class="asset-download-btn">
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 1v9M4.5 7l3.5 3.5L11.5 7M2 13h12" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  Download
                </span>
              </a>
            ))}
          </div>
          <div class="download-stats">
            <span class="stats-icon">↓</span>
            <span id="download-count-voxover">—</span> downloads
          </div>

          <div class="release-notes">
            <h3>Setup notes</h3>
            <ul>
              {r.notes.map(n => <li>{n}</li>)}
            </ul>
          </div>
        </div>
      ))}

      <div class="source-note">
        <p>
          All tools are open source.
          <a href="https://github.com/Badakonpro/ai-translate-dub" target="_blank" rel="noopener">View source on GitHub</a>
          or run from source if you prefer not to use the pre-built DMG.
        </p>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
.page-header { margin-bottom: 2.5rem; }
.page-header p { color: var(--color-text-secondary); }

.release-card {
  background: var(--color-bg); border: 1px solid var(--color-border);
  border-radius: var(--radius-lg); padding: 2rem; margin-bottom: 2rem;
}
.release-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
.release-tool { font-size: 1.2rem; margin-bottom: 0.5rem; }
.release-meta { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
.release-version { font-size: 0.8125rem; font-weight: 700; color: var(--color-text); }
.release-date { font-size: 0.8125rem; color: var(--color-text-muted); }

.assets-list { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1.5rem; }
.asset-row {
  display: flex; align-items: center; gap: 1rem;
  padding: 0.9rem 1.1rem; border: 1px solid var(--color-border);
  border-radius: var(--radius-md); text-decoration: none; color: inherit;
  transition: border-color 0.15s, background 0.15s;
}
.asset-row:hover { border-color: var(--color-accent); background: #fafafa; }
.asset-icon { font-size: 1.25rem; flex-shrink: 0; }
.asset-info { flex: 1; min-width: 0; }
.asset-label { display: block; font-size: 0.9375rem; font-weight: 600; }
.asset-filename { display: block; font-size: 0.8rem; color: var(--color-text-muted); font-family: monospace; }
.asset-size { font-size: 0.8125rem; color: var(--color-text-muted); flex-shrink: 0; }
.asset-download-btn {
  display: flex; align-items: center; gap: 0.4rem;
  font-size: 0.8125rem; font-weight: 600; color: var(--color-accent);
  background: #EEF2FF; border-radius: 6px; padding: 0.35rem 0.75rem;
  flex-shrink: 0;
}

.release-notes h3 { font-size: 0.875rem; font-weight: 700; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.75rem; }
.release-notes ul { list-style: none; display: flex; flex-direction: column; gap: 0.35rem; }
.release-notes li { font-size: 0.875rem; color: var(--color-text-secondary); padding-left: 1.1rem; position: relative; }
.release-notes li::before { content: "→"; position: absolute; left: 0; color: var(--color-accent); }

.source-note { padding: 1.25rem 1.5rem; background: var(--color-bg-subtle); border: 1px solid var(--color-border); border-radius: var(--radius-md); font-size: 0.9rem; color: var(--color-text-secondary); }
.source-note a { color: var(--color-accent); }

@media (max-width: 600px) {
  .asset-row { flex-wrap: wrap; }
  .asset-size { display: none; }
  .release-header { flex-direction: column; }
}

.download-stats {
  display: flex; align-items: center; gap: 0.4rem;
  font-size: 0.8125rem; color: var(--color-text-muted);
  margin-top: 0.5rem;
}
.stats-icon { font-style: normal; }
</style>

<script>
// @ts-nocheck
const WORKER = "";

async function trackDownload(e, el) {
  e.preventDefault();
  const asset = el.dataset.asset;
  const url = el.dataset.url;
  if (!asset || !url) {
    return;
  }
  try {
    const res = await fetch(`${WORKER}/download?asset=${asset}`, { method: "POST" });
    if (res.ok) {
      const { count } = await res.json();
      const el2 = document.getElementById(`download-count-${asset.replace("-dmg", "")}`);
      if (el2) el2.textContent = count.toLocaleString();
    }
  } catch (_) {}
  window.location.href = url;
}

// 页面加载时获取当前计数
(async () => {
  try {
    const res = await fetch(`${WORKER}/count?asset=voxover-dmg`);
    if (res.ok) {
      const { count } = await res.json();
      const el = document.getElementById("download-count-voxover");
      if (el) el.textContent = count.toLocaleString();
    }
  } catch (_) {}
})();
</script>
