---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getLatestRelease } from '../lib/release';
import { getLatestYTDRelease } from '../lib/release-ytdownloader';

const rel = await getLatestRelease();
const ytdRel = await getLatestYTDRelease();

const organizationSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "LingYue Tools",
  "url": "https://lingyuetools.org",
  "description": "Free lightweight AI tools for Mac video creators. No subscription, no account.",
  "sameAs": ["https://github.com/Badakonpro"],
  "contactPoint": { "@type": "ContactPoint", "contactType": "customer support", "email": "hello@lingyuetools.org" }
});

const tools = [
  {
    slug: "ai-translate-dub",
    name: "VoxOver",
    desc: "Free & open-source Mac app. Transcribe video with Whisper, translate subtitles via Ollama (local, no API key), DeepSeek, OpenAI, or Anthropic. Export SRT, MKV, or MP4.",
    platform: "macOS arm64",
    version: rel.tag,
    available: true,
  },
  {
    slug: "yt-downloader",
    name: "YTDownloader",
    desc: "Free native macOS YouTube downloader. Clipboard auto-detection, quality selection (best/1080p/720p/480p/360p/MP3), live progress. Bundles yt-dlp and ffmpeg.",
    platform: "macOS arm64",
    version: ytdRel.tag,
    available: true,
  },
  {
    slug: null,
    name: "Batch Subtitle Export",
    desc: "Translate and export subtitles for multiple videos at once.",
    badge: "soon",
    badgeLabel: "Soon",
    platform: "macOS",
    version: null,
    available: false,
  },
  {
    slug: null,
    name: "Audio Dubbing Studio",
    desc: "Multi-speaker AI dubbing with voice matching.",
    badge: "soon",
    badgeLabel: "Soon",
    platform: "macOS",
    version: null,
    available: false,
  },
  {
    slug: null,
    name: "Clip Trimmer",
    desc: "Cut and trim clips before translation — no timeline editor needed.",
    badge: "soon",
    badgeLabel: "Soon",
    platform: "macOS",
    version: null,
    available: false,
  },
];

const principles = [
  { icon: "🔒", title: "Local-first", desc: "Your videos stay on your machine by default. No forced cloud uploads, no account required." },
  { icon: "⚡️", title: "Lightweight & fast", desc: "Each tool solves one problem and does it well. No subscription apps, no bloated suites." },
  { icon: "🧑‍💻", title: "Made by one person", desc: "Every tool is built and maintained by a single developer. Direct feedback, direct fixes." },
  { icon: "🆓", title: "Free to download", desc: "All tools are free. Some may have optional paid AI backends (e.g. DeepSeek API), but the app itself is free." },
];
---

<Layout title="Home" description="LingYue Tools — free open-source AI tools for Mac video creators. VoxOver: transcribe with Whisper, translate subtitles via Ollama/DeepSeek/OpenAI/Anthropic, export SRT/MKV/MP4. No subscription, no account.">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={organizationSchema} />
  </Fragment>
  <Nav slot="nav" />

  <!-- HERO -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-eyebrow">Lightweight AI tools for Mac</div>
      <h1 class="hero-title">
        Small tools.<br/>
        <span class="hero-title-accent">Big workflows.</span>
      </h1>
      <p class="hero-subtitle">
        LingYue Tools is a personal collection of focused Mac apps for video creators —
        subtitle translation, AI dubbing, clip editing, and more.
        No subscription. No account. Just download and run.
      </p>
      <div class="hero-actions">
        <a href="/tools" class="btn btn-primary btn-lg">Browse Tools</a>
        <a href="/download" class="btn btn-outline btn-lg">Download Now</a>
      </div>
    </div>
  </section>

  <!-- TOOLS GRID -->
  <section class="section tools-section">
    <div class="container">
      <div class="section-header">
        <h2>Tools</h2>
        <a href="/tools" class="section-header-link">View all →</a>
      </div>
      <div class="tools-grid">
        {tools.map(t => (
          <div class={`tool-card ${!t.available ? 'tool-card-soon' : ''}`}>
            <div class="tool-card-top">
              <div class="tool-icon" aria-hidden="true">
                <svg width="26" height="26" viewBox="0 0 26 26" fill="none">
                  <rect width="26" height="26" rx="7" fill="#EEF2FF"/>
                  <path d="M8 9.5l5.5 3.5-5.5 3.5V9.5z" fill="#4F46E5"/>
                  <path d="M16 8h1.5M16 13h1.5M16 18h1.5" stroke="#4F46E5" stroke-width="1.25" stroke-linecap="round"/>
                </svg>
              </div>

            </div>
            <h3 class="tool-card-name">{t.name}</h3>
            <p class="tool-card-desc">{t.desc}</p>
            <div class="tool-card-footer">
              {t.available ? (
                <a href={`/tools/${t.slug}`} class="tool-card-link">Learn more →</a>
              ) : (
                <span class="tool-card-coming">Coming soon</span>
              )}
              <span class="tool-card-platform">{t.platform}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PRINCIPLES -->
  <section class="section principles-section">
    <div class="container">
      <div class="section-header">
        <h2>How these tools work</h2>
        <p>A few things that are true about every tool on this site.</p>
      </div>
      <div class="principles-grid">
        {principles.map(p => (
          <div class="principle-card">
            <div class="principle-icon">{p.icon}</div>
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FEATURED TOOL -->
  <section class="section featured-section">
    <div class="container">
      <div class="section-header">
        <h2>Featured right now</h2>
      </div>
      <div class="featured-card">
        <div class="featured-card-body">
          <div class="featured-meta">
            <span class="featured-version">{rel.tag}</span>
          </div>
          <h3 class="featured-name">VoxOver</h3>
          <p class="featured-desc">
            Drop in any video, pick a Whisper model for transcription, choose a translation
            backend (local Ollama, DeepSeek, OpenAI, or Anthropic), and export a translated SRT, MKV soft-sub,
            or MP4 with baked-in subtitles. Runs entirely on your Mac.
          </p>
          <div class="featured-actions">
            <a href="/tools/ai-translate-dub" class="btn btn-primary">See Details</a>
            <a href="/download" class="btn btn-outline">Download</a>
          </div>
        </div>
        <div class="featured-card-tags">
          <p class="tags-label">What it does</p>
          <div class="tags">
            <span>Whisper transcription</span>
            <span>Ollama local AI</span>
            <span>DeepSeek API</span>
            <span>SRT export</span>
            <span>MKV soft-sub</span>
            <span>MP4 hard-sub</span>
            <span>macOS arm64</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- INDIE NOTE -->
  <section class="section">
    <div class="container">
      <div class="indie-note">
        <div class="indie-avatar" aria-hidden="true">👨‍💻</div>
        <div>
          <h3>Built by one developer</h3>
          <p>
            LingYue Tools is a side project. I build tools I actually need, then share them.
            If you have a bug, a feature idea, or just want to say hello — email me directly.
            I read everything.
          </p>
          <div style="display:flex;gap:0.75rem;margin-top:1rem;flex-wrap:wrap;">
            <a href="/about" class="btn btn-outline">About</a>
            <a href="mailto:hello@lingyuetools.org" class="btn btn-outline">hello@lingyuetools.org</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
/* HERO */
.hero {
  padding: 6rem 0 5rem;
  text-align: center;
  border-bottom: 1px solid var(--color-border);
}
.hero-eyebrow {
  display: inline-block;
  font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.08em;
  text-transform: uppercase; color: var(--color-accent);
  margin-bottom: 1.25rem;
}
.hero-title {
  max-width: 14ch; margin: 0 auto 1.25rem;
  line-height: 1.1;
}
.hero-title-accent { color: var(--color-accent); }
.hero-subtitle {
  max-width: 52ch; margin: 0 auto 2rem;
  font-size: 1.0625rem; color: var(--color-text-secondary); line-height: 1.7;
}
.hero-actions { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; }

/* SECTION HEADER */
.section-header {
  display: flex; align-items: baseline; justify-content: space-between;
  margin-bottom: 1.75rem; flex-wrap: wrap; gap: 0.5rem;
}
.section-header h2 { margin: 0; }
.section-header p { margin: 0.25rem 0 0; font-size: 0.9375rem; color: var(--color-text-secondary); flex-basis: 100%; }
.section-header-link { font-size: 0.875rem; color: var(--color-accent); text-decoration: none; font-weight: 600; flex-shrink: 0; }
.section-header-link:hover { text-decoration: underline; }

/* TOOLS GRID */
.tools-section {
  background: var(--color-bg-subtle);
  border-bottom: 1px solid var(--color-border);
}
.tools-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 1rem;
}
.tool-card {
  background: var(--color-bg); border: 1px solid var(--color-border);
  border-radius: var(--radius-lg); padding: 1.4rem;
  display: flex; flex-direction: column; gap: 0.5rem;
}
.tool-card-soon { opacity: 0.6; }
.tool-card-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.35rem; }
.tool-icon { line-height: 0; }
.tool-card-name { font-size: 0.9375rem; font-weight: 700; margin: 0; }
.tool-card-desc { font-size: 0.875rem; color: var(--color-text-secondary); line-height: 1.6; flex: 1; }
.tool-card-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 0.75rem; }
.tool-card-link { font-size: 0.8125rem; font-weight: 600; color: var(--color-accent); text-decoration: none; }
.tool-card-link:hover { text-decoration: underline; }
.tool-card-coming { font-size: 0.8125rem; color: var(--color-text-muted); }
.tool-card-platform { font-size: 0.75rem; color: var(--color-text-muted); }

/* PRINCIPLES */
.principles-section { border-bottom: 1px solid var(--color-border); }
.principles-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1.25rem;
}
.principle-card {
  background: var(--color-bg); border: 1px solid var(--color-border);
  border-radius: var(--radius-lg); padding: 1.4rem;
}
.principle-icon { font-size: 1.5rem; margin-bottom: 0.75rem; }
.principle-card h3 { font-size: 0.9375rem; margin-bottom: 0.4rem; }
.principle-card p { font-size: 0.875rem; color: var(--color-text-secondary); line-height: 1.6; }

/* FEATURED */
.featured-section { border-bottom: 1px solid var(--color-border); }
.featured-card {
  display: grid; grid-template-columns: 1fr auto;
  gap: 2rem; align-items: start;
  background: var(--color-bg); border: 1px solid var(--color-border);
  border-radius: var(--radius-lg); padding: 2rem; box-shadow: var(--shadow-sm);
}
.featured-meta { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.6rem; }
.featured-version { font-size: 0.8rem; color: var(--color-text-muted); font-weight: 600; }
.featured-name { font-size: 1.3rem; margin: 0 0 0.6rem; }
.featured-desc { font-size: 0.9375rem; color: var(--color-text-secondary); max-width: 55ch; line-height: 1.7; margin: 0 0 1.25rem; }
.featured-actions { display: flex; gap: 0.6rem; flex-wrap: wrap; }
.featured-card-tags { min-width: 180px; }
.tags-label { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-text-muted); margin-bottom: 0.6rem; }
.tags { display: flex; flex-wrap: wrap; gap: 0.4rem; justify-content: flex-end; }
.tags span {
  font-size: 0.75rem; font-weight: 600; padding: 0.2rem 0.55rem;
  border-radius: 4px; background: var(--color-bg-muted);
  color: var(--color-text-secondary); border: 1px solid var(--color-border);
}

/* INDIE NOTE */
.indie-note {
  display: flex; gap: 1.5rem; align-items: flex-start;
  max-width: 640px; margin: 0 auto;
  background: var(--color-bg-subtle); border: 1px solid var(--color-border);
  border-radius: var(--radius-lg); padding: 2rem;
}
.indie-avatar { font-size: 2.5rem; line-height: 1; padding-top: 0.1rem; flex-shrink: 0; }
.indie-note h3 { margin-bottom: 0.5rem; }
.indie-note p { font-size: 0.9375rem; color: var(--color-text-secondary); line-height: 1.7; }

@media (max-width: 760px) {
  .featured-card { grid-template-columns: 1fr; }
  .tags { justify-content: flex-start; }
}
@media (max-width: 580px) {
  .hero { padding: 4rem 0 3.5rem; }
  .indie-note { flex-direction: column; }
}
</style>
