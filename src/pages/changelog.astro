---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const releases = [
  {
    version: "v0.1.0 Beta",
    date: "2026-05-28",
    type: "beta",
    notes: [
      "Initial Beta release",
      "Import MP4 and MOV video files",
      "Automatic speech transcription via Whisper",
      "Subtitle translation to 50+ languages",
      "Export translated SRT subtitle files",
      "Export video with hardcoded (burnt-in) captions",
      "Optimized for Apple Silicon",
    ],
    known: [
      "Very long videos (> 2 hours) may be slow to process",
      "App not yet notarized — first launch requires right-click → Open",
    ],
  },
];
---

<Layout title="Changelog" description="Release notes and version history for Video Translator for Mac and other Tiny Video Tools.">
  <Nav slot="nav" />

  <section class="page-hero">
    <div class="container">
      <h1>Changelog</h1>
      <p class="page-subtitle">Version history for Video Translator for Mac.</p>
    </div>
  </section>

  <section class="section-sm">
    <div class="container changelog-layout">
      <div class="changelog-list">
        {releases.map(release => (
          <article class="release">
            <div class="release-header">
              <div class="release-title-row">
                <h2 class="release-version">{release.version}</h2>
                {release.type === "beta" && <span class="badge badge-beta">Beta</span>}
                {release.type === "stable" && <span class="badge badge-new">Stable</span>}
              </div>
              <time class="release-date" datetime={release.date}>
                {new Date(release.date).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
              </time>
            </div>

            <div class="release-body">
              <div class="change-group">
                <p class="change-group-label">What's new</p>
                <ul class="change-list">
                  {release.notes.map(note => (
                    <li>
                      <svg class="change-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><circle cx="7" cy="7" r="7" fill="#D1FAE5"/><path d="M4 7l2 2 4-4" stroke="#059669" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      {note}
                    </li>
                  ))}
                </ul>
              </div>

              {release.known && release.known.length > 0 && (
                <div class="change-group">
                  <p class="change-group-label change-group-label--known">Known issues</p>
                  <ul class="change-list change-list--known">
                    {release.known.map(issue => (
                      <li>
                        <svg class="change-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><circle cx="7" cy="7" r="7" fill="#FEF3C7"/><path d="M7 4v3.5M7 9.5v.5" stroke="#D97706" stroke-width="1.25" stroke-linecap="round"/></svg>
                        {issue}
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              <a href="/download" class="btn btn-outline release-download-btn">
                <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true"><path d="M6.5 1.5v7M3.5 6l3 3 3-3M1 11h11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Download this version
              </a>
            </div>
          </article>
        ))}
      </div>

      <aside class="changelog-sidebar">
        <div class="sidebar-card">
          <p class="sidebar-card-title">Subscribe to updates</p>
          <p>Get notified when a new version is released.</p>
          <!-- Replace with your actual form link -->
          <a href="https://tally.so/r/YOURFORM" class="btn btn-outline" target="_blank" rel="noopener noreferrer" style="margin-top:0.85rem;font-size:0.875rem;">
            Notify me
          </a>
        </div>
        <div class="sidebar-card">
          <p class="sidebar-card-title">All releases on GitHub</p>
          <p>Download older versions or view release assets directly.</p>
          <a href="https://github.com/YOUR_USERNAME/video-translator/releases" class="btn btn-outline" target="_blank" rel="noopener noreferrer" style="margin-top:0.85rem;font-size:0.875rem;">
            GitHub Releases →
          </a>
        </div>
      </aside>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
  .page-hero { padding: 4rem 0 2.5rem; border-bottom: 1px solid var(--color-border); }
  .page-hero h1 { margin-bottom: 0.4rem; }
  .page-subtitle { font-size: 1rem; color: var(--color-text-secondary); }

  .changelog-layout {
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: 3rem;
    align-items: start;
  }

  .changelog-list { display: flex; flex-direction: column; gap: 0; }

  .release {
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .release:last-child { border-bottom: none; }

  .release-header { margin-bottom: 1.5rem; }
  .release-title-row { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.35rem; }
  .release-version { font-size: 1.25rem; }
  .release-date { font-size: 0.875rem; color: var(--color-text-muted); }

  .release-body { display: flex; flex-direction: column; gap: 1.5rem; }

  .change-group { display: flex; flex-direction: column; gap: 0.65rem; }
  .change-group-label {
    font-size: 0.75rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.06em; color: var(--color-text-muted);
  }
  .change-group-label--known { color: #D97706; }

  .change-list { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; }
  .change-list li { display: flex; align-items: flex-start; gap: 0.55rem; font-size: 0.9375rem; color: var(--color-text-secondary); line-height: 1.5; }
  .change-icon { flex-shrink: 0; margin-top: 0.15rem; }

  .release-download-btn { align-self: flex-start; font-size: 0.875rem; padding: 0.45rem 0.9rem; }

  /* Sidebar */
  .changelog-sidebar { display: flex; flex-direction: column; gap: 1rem; position: sticky; top: 80px; }
  .sidebar-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    display: flex; flex-direction: column;
  }
  .sidebar-card-title { font-weight: 700; font-size: 0.9rem; color: var(--color-text); margin-bottom: 0.35rem; }

  @media (max-width: 760px) {
    .changelog-layout { grid-template-columns: 1fr; }
    .changelog-sidebar { order: -1; position: static; }
  }
</style>
