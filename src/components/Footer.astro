---
const year = new Date().getFullYear();
const lang = Astro.url.pathname.startsWith('/zh') ? 'zh' : 'en';
const p = lang === 'zh' ? '/zh' : '';
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href={`${p}/`} class="footer-logo">LingYue Tools</a>
      <p class="footer-tagline">{lang === 'zh' ? '专为视频翻译与配音打造的轻量 AI 工具。' : 'Lightweight AI tools for video translation & dubbing.'}</p>
    </div>

    <nav class="footer-links" aria-label="Footer navigation">
      <div class="footer-col">
        <p class="footer-col-title">{lang === 'zh' ? '工具' : 'Tools'}</p>
        <a href={`${p}/tools/ai-translate-dub`}>{lang === 'zh' ? 'VoxOver' : 'VoxOver'}</a>
        <a href={`${p}/tools`}>{lang === 'zh' ? '全部工具' : 'All Tools'}</a>
      </div>
      <div class="footer-col">
        <p class="footer-col-title">{lang === 'zh' ? '产品' : 'Product'}</p>
        <a href={`${p}/download`}>{lang === 'zh' ? '下载' : 'Download'}</a>
        <a href={`${p}/changelog`}>{lang === 'zh' ? '更新日志' : 'Changelog'}</a>
      </div>
      <div class="footer-col">
        <p class="footer-col-title">{lang === 'zh' ? '其他' : 'Company'}</p>
        <a href={`${p}/about`}>{lang === 'zh' ? '关于' : 'About'}</a>
        <a href={`${p}/privacy`}>{lang === 'zh' ? '隐私政策' : 'Privacy'}</a>
        <a href="mailto:hello@lingyuetools.org">{lang === 'zh' ? '联系我们' : 'Contact'}</a>
      </div>
    </nav>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <p>© {year} LingYue Tools · {lang === 'zh' ? '由独立开发者构建' : 'Made by an independent developer'}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-subtle);
    margin-top: auto;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3rem;
    padding-top: 3rem;
    padding-bottom: 3rem;
  }

  .footer-logo {
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--color-text);
    text-decoration: none !important;
  }
  .footer-tagline {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    max-width: 26ch;
    line-height: 1.6;
  }

  .footer-links {
    display: flex;
    gap: 3rem;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .footer-col-title {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 0.15rem;
  }
  .footer-col a {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    text-decoration: none !important;
    transition: color 0.15s;
  }
  .footer-col a:hover { color: var(--color-text); }

  .footer-bottom {
    border-top: 1px solid var(--color-border);
    padding: 1.1rem 0;
  }
  .footer-bottom p {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 720px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .footer-links { gap: 2rem; flex-wrap: wrap; }
  }
</style>
