---
const pathname = Astro.url.pathname;
const lang = pathname.startsWith('/zh') ? 'zh' : 'en';
const prefix = lang === 'zh' ? '/zh' : '';

const navLinks = lang === 'zh' ? [
  { href: `${prefix}/tools`, label: "工具" },
  { href: `${prefix}/download`, label: "下载" },
  { href: `${prefix}/changelog`, label: "更新日志" },
  { href: `${prefix}/about`, label: "关于" },
] : [
  { href: "/tools", label: "Tools" },
  { href: "/download", label: "Download" },
  { href: "/changelog", label: "Changelog" },
  { href: "/about", label: "About" },
];

const logoHref = lang === 'zh' ? '/zh/' : '/';
const downloadHref = `${prefix}/download`;
const downloadLabel = lang === 'zh' ? '下载 Beta' : 'Download Beta';
const brandPill = lang === 'zh'
  ? '原生 macOS · Apple Silicon 硬件加速'
  : 'Native macOS · Apple Silicon Acceleration';

// Language switcher
const switchLabel = lang === 'zh' ? 'EN' : '中文';
const switchHref = lang === 'en'
  ? `/zh${pathname === '/' ? '/' : pathname}`
  : (pathname.replace(/^\/zh/, '') || '/');
---

<header class="site-nav">
  <div class="container nav-inner">
    <a href={logoHref} class="nav-logo" aria-label="LingYue Tools home">
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
        <rect width="22" height="22" rx="5" fill="#4F46E5"/>
        <path d="M7 8.5L11 6L15 8.5V13.5L11 16L7 13.5V8.5Z" fill="white" opacity="0.9"/>
        <circle cx="11" cy="11" r="2" fill="#4F46E5"/>
      </svg>
      <span>LingYue Tools</span>
    </a>

    <nav class="nav-links" aria-label="Main navigation">
      {navLinks.map(link => (
        <a
          href={link.href}
          class:list={["nav-link", { active: pathname.startsWith(link.href) }]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <span class="nav-brand-pill">{brandPill}</span>

    <div class="nav-actions">
      <a href={switchHref} class="lang-toggle" lang={lang === 'zh' ? 'en' : 'zh'}>{switchLabel}</a>
      <a href={downloadHref} class="btn btn-primary nav-cta">
        {downloadLabel}
      </a>
    </div>

    <!-- Mobile menu toggle -->
    <button class="nav-hamburger" id="menuToggle" aria-label="Toggle menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div class="mobile-menu" id="mobileMenu" hidden>
    <nav class="mobile-nav">
      <div class="mobile-brand-pill">{brandPill}</div>
      {navLinks.map(link => (
        <a href={link.href} class="mobile-nav-link">{link.label}</a>
      ))}
      <div style="display:flex;gap:0.5rem;margin-top:0.5rem;align-items:center;">
        <a href={downloadHref} class="btn btn-primary" style="flex:1;justify-content:center;">{downloadLabel}</a>
        <a href={switchHref} class="lang-toggle" lang={lang === 'zh' ? 'en' : 'zh'}>{switchLabel}</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menuToggle');
  const menu   = document.getElementById('mobileMenu');
  toggle?.addEventListener('click', () => {
    const open = !menu?.hidden;
    menu!.hidden = open;
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.classList.toggle('open', !open);
  });
</script>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    height: 60px;
    gap: 2rem;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none !important;
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--color-text);
    flex-shrink: 0;
  }
  .nav-logo:hover { color: var(--color-accent); }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex: 1;
  }

  .nav-link {
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none !important;
    transition: color 0.15s, background 0.15s;
  }
  .nav-link:hover { color: var(--color-text); background: var(--color-bg-muted); }
  .nav-link.active { color: var(--color-accent); background: var(--color-accent-subtle); }

  .nav-actions { display: flex; align-items: center; gap: 0.75rem; }
  .nav-cta { padding: 0.45rem 1rem; font-size: 0.875rem; }

  .nav-brand-pill {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-accent);
    border: 1px solid #c7d2fe;
    background: #eef2ff;
    border-radius: 999px;
    padding: 0.3rem 0.55rem;
    white-space: nowrap;
    line-height: 1;
  }

  .lang-toggle {
    font-size: 0.8125rem; font-weight: 600;
    color: var(--color-text-secondary);
    text-decoration: none !important;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    transition: color 0.15s, border-color 0.15s, background 0.15s;
    flex-shrink: 0;
  }
  .lang-toggle:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: var(--color-accent-subtle);
  }

  .nav-hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    background: none;
    border: none;
    padding: 6px;
    margin-left: auto;
  }
  .nav-hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-text-secondary);
    border-radius: 2px;
    transition: all 0.2s;
  }
  .nav-hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-hamburger.open span:nth-child(2) { opacity: 0; }
  .nav-hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .mobile-menu {
    border-top: 1px solid var(--color-border);
    background: var(--color-bg);
  }
  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 1.25rem 1.25rem;
  }
  .mobile-brand-pill {
    display: inline-flex;
    align-self: flex-start;
    margin-bottom: 0.5rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-accent);
    border: 1px solid #c7d2fe;
    background: #eef2ff;
    border-radius: 999px;
    padding: 0.3rem 0.55rem;
    line-height: 1;
  }
  .mobile-nav-link {
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-sm);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text);
    text-decoration: none !important;
    transition: background 0.15s;
  }
  .mobile-nav-link:hover { background: var(--color-bg-muted); }

  @media (max-width: 720px) {
    .nav-links, .nav-actions, .nav-brand-pill { display: none; }
    .nav-hamburger { display: flex; }
  }

  @media (max-width: 1100px) {
    .nav-brand-pill { display: none; }
  }
</style>
